# ==============================================================================
# Plantilla de variables de entorno - Portal Interno de Consulta de Políticas de RRHH
# Copiar como .env en el entorno local y completar con valores reales.
# NUNCA subir archivos .env ni credenciales reales al repositorio.
# ==============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Seguridad / Auth ---
JWT_SECRET=cambiar_por_secreto_seguro
JWT_EXPIRES_IN=8h

# --- Base de Datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portal_rrhh_db
DB_USER=root
DB_PASSWORD=

# --- Google Drive API ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=./backend/credentials/service-account.json

# --- LLM y Embeddings ---
LLM_PROVIDER=gemini
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# --- Base Vectorial ---
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_URL=http://localhost:8000
VECTOR_COLLECTION_NAME=politicas_rrhh

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:3000/api
